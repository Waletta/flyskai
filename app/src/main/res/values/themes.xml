<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FlyskAI" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Navigation View Customizations -->
        <item name="navigationViewStyle">@style/Widget.FlyskAI.NavigationView</item>

        <!-- Customize your theme here. -->
    </style>

    <!-- NavigationView Style -->
    <style name="Widget.FlyskAI.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:background">@color/black</item>
        <item name="itemTextAppearance">@style/TextAppearance.FlyskAI.NavigationMenu</item>
        <item name="itemIconTint">@color/white</item>
    </style>

    <!-- Navigation Menu Text Appearance -->
    <style name="TextAppearance.FlyskAI.NavigationMenu" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.FlyskAI.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FlyskAI.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.FlyskAI.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>